FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
# Inside Docker the host is "db"; for a local (non-Docker) backend use localhost.
DATABASE_URL=postgresql+psycopg://s3demo:s3demo@db:5432/s3demo

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=
# Leave empty for real AWS. Only set to point at a local S3 emulator (e.g. http://localhost:5001).
S3_ENDPOINT_URL=

PRESIGNED_URL_EXPIRY_SECONDS=60
MAX_UPLOAD_MB=100
# Optional: restrict uploads to these extensions (comma-separated). Empty = full allowlist.
ALLOWED_EXTENSIONS=

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

FRONTEND_URL=http://localhost:3000
